{
  "name": "hospilaty-lab-management",
  "version": "1.0.0",
  "description": "Enterprise Hospital Laboratory Management System (LMS) & Pathology Diagnostic Platform",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "server": "node backend/server.js",
    "frontend": "npm run dev --prefix frontend",
    "dev": "node index.js",
    "build": "npm run build --prefix frontend",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "health": "node index.js --health"
  },
  "keywords": [
    "hospital",
    "laboratory",
    "lims",
    "pathology",
    "healthcare",
    "hl7",
    "fhir",
    "loinc",
    "diagnostic"
  ],
  "author": "Hospital LabCare Engineering Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
